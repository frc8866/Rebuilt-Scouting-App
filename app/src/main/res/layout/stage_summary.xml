<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Alliance banner -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_position_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#BFFFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_team_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="26sp" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tv_quals_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@drawable/bg_translucent_white_6"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp" />

            <TextView
                android:layout_width="24dp"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATCH SUMMARY"
                android:textColor="#99FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <!-- Three-column body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:baselineAligned="false">

            <!-- LEFT: Driver Skill -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <include layout="@layout/section_card_header" android:id="@+id/card_driver_skill" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp"
                    android:layout_marginTop="-1dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/row_driver_skill"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="Poor" android:textColor="@color/text_dim" android:textSize="11sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Excellent" android:textColor="@color/text_dim" android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FUEL CONTRIBUTION"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Est. % of alliance fuel scored by this robot"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <SeekBar
                        android:id="@+id/seek_fuel_percent"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:paddingVertical="14dp"
                        android:splitTrack="false"
                        android:progressDrawable="@drawable/seekbar_track_fuel"
                        android:thumb="@drawable/seekbar_thumb_fuel"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_fuel_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:textColor="@color/text"
                        android:textStyle="bold"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_fuel_percent_required_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Drag the slider at least once before submitting"
                        android:textColor="@color/error_red"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

            <!-- CENTER: Robot capabilities -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAN DRIVE THROUGH"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <include layout="@layout/row_big_check" android:id="@+id/check_trench" />
                    <include layout="@layout/row_big_check" android:id="@+id/check_bump"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INTAKE SOURCES"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <include layout="@layout/row_big_check" android:id="@+id/check_ground_intake" />
                    <include layout="@layout/row_big_check" android:id="@+id/check_station"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- RIGHT: Fuel score + Won Match + Submit -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ALLIANCE FUEL SCORE"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Auto" android:textColor="@color/text_dim" android:textSize="12sp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxStrokeColor="@color/accent">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_auto_fuel_score"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:hint="Enter score"
                                    android:textColor="@color/text" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Teleop" android:textColor="@color/text_dim" android:textSize="12sp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxStrokeColor="@color/accent">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/et_teleop_fuel_score"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:hint="Enter score"
                                    android:textColor="@color/text" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                            android:text="Total" android:textColor="@color/text_dim" android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_fuel_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_fuel_required_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Both fields required before submitting"
                        android:textColor="@color/error_red"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WON MATCH?"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_12"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_won_yes"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:gravity="center"
                            android:text="YES"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:id="@+id/btn_won_no"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:gravity="center"
                            android:text="NO"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_won_required_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Required before submitting"
                        android:textColor="@color/error_red"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:text="Submit Match Data"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="12dp" />

                <ProgressBar
                    android:id="@+id/progress_submitting"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-48dp"
                    android:indeterminateTint="@color/black"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_submit_locked_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Fill in all fields.."
                    android:textColor="@color/error_red"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
